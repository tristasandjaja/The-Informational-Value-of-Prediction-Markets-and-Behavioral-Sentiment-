def fetch_sp500_live(start: str, end: str) -> pd.DataFrame:
    import yfinance as yf

   
    raw = yf.download("^GSPC", start=start, end=end, auto_adjust=True)
    prices = raw["Close"].squeeze()

   
    returns = prices.pct_change().dropna()

    df = pd.DataFrame({"sp500_return": returns})
    df.index = pd.to_datetime(df.index).normalize()
    df.index.name = "date"
    return df


def simulate_sp500(start: str, end: str) -> pd.DataFrame:
    
    dates = pd.bdate_range(start=start, end=end)
    n = len(dates)

  
    omega, alpha, beta = 0.000002, 0.08, 0.90
    mu = 0.0004  

    
    h = np.zeros(n)
    r = np.zeros(n)
    h[0] = omega / (1 - alpha - beta)  

    
    eps = np.random.standard_t(df=6, size=n)

    
    for t in range(1, n):
        h[t] = omega + alpha * r[t-1]**2 + beta * h[t-1]
        r[t] = mu + np.sqrt(h[t]) * eps[t]

    
    regime = np.ones(n)
    regime[80:100]  = 2.5   
    regime[200:215] = 2.0   
    regime[380:400] = 1.8   
    r = r * regime

    
    np.random.seed(42)

    df = pd.DataFrame({"sp500_return": r}, index=dates)
    df.index.name = "date"
    print(f"  [S&P 500] Simulated {n} trading days ({start} → {end})")
    return df


POLYMARKET_CONTRACTS = [
    "will-the-fed-raise-rates-at-the-march-2023-meeting",
    "will-the-fed-raise-rates-at-the-may-2023-meeting",
    "will-the-fed-cut-rates-at-the-september-2024-meeting",
    "will-the-fed-cut-rates-at-the-november-2024-meeting",
    "will-the-fed-cut-rates-at-the-december-2024-meeting",
]

def fetch_polymarket_live(dates: pd.DatetimeIndex) -> pd.Series:
    """
    LIVE MODE: Pull historical Polymarket contract prices via their API.

    Steps:
    1. Look up each contract by its URL slug to get its internal ID
    2. Pull the full price history for each contract
    3. Average across all active contracts (composite Fed expectations index)
    4. Take the daily first difference → PM_t (daily change in probability)
    """
    import requests

    base = "https://gamma-api.polymarket.com/markets"
    all_series = []

    for slug in POLYMARKET_CONTRACTS:
        try:
            
            resp = requests.get(f"{base}?slug={slug}", timeout=10)
            market = resp.json()[0]
            cid = market["conditionId"]

            
            hist_url = f"https://clob.polymarket.com/prices-history?market={cid}&interval=1d&fidelity=1440"
            h = requests.get(hist_url, timeout=15).json()

            
            series = pd.DataFrame(h["history"])
            series["t"] = pd.to_datetime(series["t"], unit="s").dt.normalize()
            series = series.set_index("t")["p"].rename(slug)
            all_series.append(series)

        except Exception as e:
            print(f"  [Polymarket] Skipping {slug}: {e}")

    if not all_series:
        raise RuntimeError("No Polymarket data fetched.")

    
    combined = pd.concat(all_series, axis=1).reindex(dates).ffill()
    pm_level = combined.mean(axis=1)

    
    pm_change = pm_level.diff()
    pm_change.name = "PM_t"
    return pm_change


def simulate_polymarket(dates: pd.DatetimeIndex,
                        sp500_returns: pd.Series) -> pd.Series:
    
    n = len(dates)
    r = sp500_returns.values

    
    prob = np.zeros(n)
    prob[0] = 0.45
    phi = 0.92         
    noise_scale = 0.018  

    for t in range(1, n - 1):
        predictive_signal = -0.35 * r[t + 1]   

       
        contemp_update = -0.20 * r[t]

        macro_shock = predictive_signal + contemp_update

        
        prob[t] = phi * prob[t-1] + (1 - phi) * 0.50 + macro_shock * 0.20
        prob[t] += np.random.normal(0, noise_scale)

       
        prob[t] = np.clip(prob[t], 0.01, 0.99)

    
    fomc_days = [20, 60, 100, 140, 180, 230, 280, 330, 380, 420, 460]
    for d in fomc_days:
        if d < n - 3:
            
            direction = -np.sign(r[min(d+1, n-1)])
            prob[d:d+2] += direction * np.random.uniform(0.05, 0.12)
            prob[d:d+2] = np.clip(prob[d:d+2], 0.01, 0.99)

   
    pm_change = np.diff(prob, prepend=prob[0])

    
    std = pm_change.std()
    pm_change = np.clip(pm_change, -3*std, 3*std)

    pm_series = pd.Series(pm_change, index=dates, name="PM_t")
    print(f"  [Polymarket] Simulated {n} daily ΔPM observations")
    return pm_series




def fetch_finbert_live(dates: pd.DatetimeIndex) -> pd.Series:
    
    from transformers import pipeline
    import requests

    
    finbert = pipeline("text-classification",
                       model="ProsusAI/finbert",
                       return_all_scores=True)
    daily_scores = []

    for date in dates:
        date_str = date.strftime("%Y%m%d%H%M%S")

        
        gdelt_url = (
            f"https://api.gdeltproject.org/api/v2/doc/doc"
            f"?query=S%26P%20500%20stock%20market&"
            f"mode=artlist&maxrecords=20&"
            f"startdatetime={date_str}&"
            f"enddatetime={date_str[:-6]}235959&"
            f"format=json"
        )
        try:
            articles = requests.get(gdelt_url, timeout=10).json().get("articles", [])
            headlines = [a["title"] for a in articles if "title" in a]

            if not headlines:
                daily_scores.append(np.nan)
                continue

            
            scores = finbert(headlines[:15])

            
            sent = np.mean([
                next(s["score"] for s in day if s["label"] == "positive") -
                next(s["score"] for s in day if s["label"] == "negative")
                for day in scores
            ])
            daily_scores.append(sent)

        except Exception:
            daily_scores.append(np.nan)  

    series = pd.Series(daily_scores, index=dates, name="Sent_t")
  
    series = series.interpolate(method="time").ffill().bfill()
    return series


def simulate_finbert_sentiment(dates: pd.DatetimeIndex,
                                sp500_returns: pd.Series) -> pd.Series:
    
    n = len(dates)
    r = sp500_returns.values
    sent = np.zeros(n)
    phi = 0.55  

    for t in range(1, n - 1):
        
        predictive = 0.28 * r[t + 1]

        
        contemp = 0.35 * r[t]

       
        noise = np.random.standard_t(df=5) * 0.06

        
        sent[t] = phi * sent[t-1] + predictive + contemp + noise

        
        sent[t] = np.clip(sent[t], -1.0, 1.0)

    
    macro_events = [15, 45, 85, 130, 175, 220, 270, 320, 370, 415]
    for d in macro_events:
        if d < n - 1:
            direction = np.sign(r[d + 1]) if r[d + 1] != 0 else 1
            sent[d] += direction * np.random.uniform(0.12, 0.28)
            sent[d]  = np.clip(sent[d], -1.0, 1.0)

    series = pd.Series(sent, index=dates, name="Sent_t")
    print(f"  [FinBERT]   Simulated {n} daily sentiment scores")
    return series




def build_dataset() -> pd.DataFrame:
   
    print("\n" + "="*60)
    print("  DATA COLLECTION PIPELINE")
    print("="*60)
    print(f"  Mode      : {'LIVE (API)' if USE_LIVE_DATA else 'SIMULATED (reproducible)'}")
    print(f"  Period    : {START_DATE} → {END_DATE}")
    print()

    
    if USE_LIVE_DATA:
        sp_df = fetch_sp500_live(START_DATE, END_DATE)
    else:
        sp_df = simulate_sp500(START_DATE, END_DATE)

    dates = sp_df.index
    r = sp_df["sp500_return"]

    
    if USE_LIVE_DATA:
        pm = fetch_polymarket_live(dates)
    else:
        pm = simulate_polymarket(dates, r)

    
    if USE_LIVE_DATA:
        sent = fetch_finbert_live(dates)
    else:
        sent = simulate_finbert_sentiment(dates, r)

    
    df = pd.DataFrame({
        "sp500_return" : r,
        "PM_t"         : pm,
        "Sent_t"       : sent,
    }, index=dates)

    
    df["r_t"]  = df["sp500_return"]           
    df["r_t1"] = df["sp500_return"].shift(1)  
    df["r_t2"] = df["sp500_return"].shift(2)  

    
    df["y_next"] = (df["sp500_return"].shift(-1) > 0).astype(int)

    
    df = df.dropna().copy()

    
    print(f"\n  Dataset shape : {df.shape}")
    print(f"  Date range    : {df.index[0].date()} → {df.index[-1].date()}")
    print(f"  Positive days : {df['y_next'].mean():.1%}")   
    print()

 
    df.to_csv(OUTPUT_FILE)
    print(f"  Saved → {OUTPUT_FILE}")
    print("="*60 + "\n")

    return df



if __name__ == "__main__":
    df = build_dataset()
    print(df.tail())   
