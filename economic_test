def economic_value_longshort():
    
    print("\n── ADDITION 1 (Revised): Long/Short Economic Value ─────")
    df = make_dataset("SP500", horizon=1)
    T0 = int(len(df) * TRAIN_FRAC)
    oos_df = df.iloc[T0:].copy()
    daily_r = oos_df["sp500_return"].values
    n_days  = len(daily_r)
    rf_daily = 0.05 / 252
    gamma = 3.0  

    results_ls = {}

    for model_name, features in MODELS.items():
        res = expanding_window(df, features, horizon=1)
        signals = np.where(res["y_pred"].values == 1, 1, -1)  
        strat_r = signals * daily_r
        cum     = np.cumprod(1 + strat_r)
        ann_ret = cum[-1] ** (252 / n_days) - 1
