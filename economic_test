        sharpe  = (excess.mean() / excess.std()) * np.sqrt(252)
        peak    = np.maximum.accumulate(cum)
        max_dd  = ((cum - peak) / peak).min()
        
        ann_vol = strat_r.std() * np.sqrt(252)
        cer     = ann_ret - 0.5 * gamma * ann_vol**2
        results_ls[model_name] = {
            "cum_returns": cum, "ann_ret": ann_ret, "sharpe": sharpe,
            "max_dd": max_dd, "cer": cer, "strat_r": strat_r
