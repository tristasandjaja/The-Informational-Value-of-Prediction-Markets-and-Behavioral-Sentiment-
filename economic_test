def summary_table(ev_tbl, horizon_tbl, index_tbl):
    """Single clean summary table for paper — Panel A/B/C format."""
    
    panel_a = ev_tbl[["Strategy", "Ann. Return (%)", "Sharpe Ratio", "Max Drawdown (%)"]].copy()
    panel_a.insert(0, "Panel", "A: Economic Value")

    
    pb = horizon_tbl[horizon_tbl["Model"]=="M3_Integrated"][
        ["Horizon", "DA (%)", "DA vs Naive (pp)", "RMSE"]].copy()
    pb.insert(0, "Panel", "B: Alt. Horizon (M3)")
    pb = pb.rename(columns={"Horizon": "Strategy"})

   
    pc = index_tbl[index_tbl["Model"]=="M3_Integrated"][
        ["Index", "DA (%)", "DA vs Naive (pp)", "RMSE"]].copy()
    pc.insert(0, "Panel", "C: Alt. Index (M3)")
    pc = pc.rename(columns={"Index": "Strategy"})

    summary = pd.concat([panel_a, pb, pc], ignore_index=True)
    summary.to_csv(f"{OUT}/Table_Robustness_Summary.csv", index=False)
    print("\n── Robustness Summary ──────────────────────────────────")
    print(summary.to_string(index=False))
    return summary




